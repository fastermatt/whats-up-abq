# ─── Supabase ──────────────────────────────────────────────────────────────────
# Project URL for the existing project (v1 + v2 schema live here)
NEXT_PUBLIC_SUPABASE_URL=https://bsmvfutebmbkjvlrhiyq.supabase.co
# Public anon key (safe to expose; RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (server-only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Upstash Redis ─────────────────────────────────────────────────────────────
# REST URL + token from Upstash console → your DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare R2 ─────────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=abq-unplugged-images
# Account ID from Cloudflare dashboard → R2
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# Public CDN base URL (set after adding custom domain or enabling R2 public access)
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.abqunplugged.com

# ─── Ticketmaster ──────────────────────────────────────────────────────────────
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# ─── SeatGeek ──────────────────────────────────────────────────────────────────
SEATGEEK_CLIENT_ID=your_seatgeek_client_id_here

# ─── Nominatim (OpenStreetMap geocoding — replaces Google Places) ────────────
# No key needed. Set a descriptive User-Agent per OSM usage policy.
NOMINATIM_USER_AGENT=abqunplugged/2.0 (your_email@example.com)

# ─── Umami Analytics ───────────────────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# ─── DeepSeek ──────────────────────────────────────────────────────────────────
# Used by /api/admin/generate-caption (AI caption generation)
DEEPSEEK_API_KEY=

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://v2.abqunplugged.com
NEXT_PUBLIC_SITE_NAME=ABQ Unplugged
